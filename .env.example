# ============================================================
# JWT
# ============================================================

# Chave compartilhada pelos serviços usuario e agendador-tarefas
# para assinatura e validação dos tokens JWT.
# Deve possuir pelo menos 32 caracteres.
# Para gerar uma chave:
# openssl rand -base64 48
JWT_SECRET=substitua-por-uma-chave-segura


# ============================================================
# PostgreSQL
# ============================================================

# Credenciais do banco de dados do serviço usuario.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
# ============================================================
# Usuário técnico do BFF
# ============================================================

# Credenciais utilizadas pela rotina agendada do BFF
# para consultar tarefas que precisam gerar notificações.
ADMIN_EMAIL=admin@admin.com
ADMIN_SENHA=1234


# ============================================================
# E-mail / SMTP
# ============================================================

# Conta utilizada para autenticação no servidor SMTP do Gmail.
MAIL_USERNAME=seu-email@gmail.com

# Senha de app da conta Gmail.
# Gere em:
# https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=sua-senha-de-app

# Endereço exibido como remetente do e-mail.
# Para Gmail, utilize um endereço autorizado pela conta SMTP.
MAIL_REMETENTE=seu-email@gmail.com

# Nome exibido para quem recebe a notificação.
MAIL_NOME_REMETENTE=Agendador de Tarefas